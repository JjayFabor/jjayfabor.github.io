{
  // IMPORTANT: this "name" must match the Worker name in your Cloudflare
  // dashboard (the one your custom domain is attached to), or wrangler will
  // deploy to a different Worker.
  "name": "personal-website",
  "compatibility_date": "2026-07-24",

  // Server entry: handles POST /api/contact (see run_worker_first below).
  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    // Serve /404.html with a real 404 for unknown paths. Every route the
    // router knows about (/, /projects, /projects/:slug) is prerendered by
    // scripts/prerender.mjs, so direct links and refreshes still hit a real
    // file — the SPA fallback only ever caught URLs that genuinely don't
    // exist, and answering those with 200 kept dead pages indexed as soft 404s.
    // NOTE: any future client-side route must be prerendered too, or it will
    // 404 on direct load.
    "not_found_handling": "404-page",
    // Serve prerendered pages at their no-slash URL (200 direct) and redirect
    // the trailing-slash form to it. This matches our canonical/sitemap URLs
    // and react-router routes (all no-slash), so the canonical URL is never a
    // redirect — e.g. /projects/lettuce-watch serves dist/projects/lettuce-watch/index.html.
    "html_handling": "drop-trailing-slash",
    // Only /api/* hits the Worker; every other path is served straight
    // from ./dist as a static asset (the Worker never runs for those).
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare Email Routing binding used by worker/index.js to send
  // contact-form messages. Email Routing only permits sending to verified
  // destination addresses, so the recipient (CONTACT_TO secret) must be one.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Queue: the fetch handler enqueues submissions (instant response); the
  // queue() handler consumes them and sends the email, retrying on failure.
  "queues": {
    "producers": [
      { "queue": "contact-emails", "binding": "CONTACT_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "contact-emails",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "contact-emails-dlq"
      }
    ]
  },

  // Per-IP rate limiting via a strongly-consistent Durable Object (one
  // instance per IP). SQLite-backed DOs are free-tier eligible. The limit
  // itself lives in worker/index.js (RATE_LIMIT / RATE_PERIOD_MS).
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ]
}
